# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS CLOUD API (Server-side only — never expose in VITE_ vars)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# TWILIO WHATSAPP VERIFY FALLBACK (Server-side only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# OTP SIGNING & FIREBASE ADMIN CUSTOM AUTH TOKEN (Server-side only)
OTP_HMAC_SECRET="change-me-in-production"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# GOOGLE MAPS PLATFORM (Map JS API, Places Autocomplete, Geocoding & Routes API)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

