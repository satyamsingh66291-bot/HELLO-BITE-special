rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Live dish listings synced across all phones
    match /dishes/{dishId} {
      allow read: if true;
      allow write: if true;
    }

    // Live orders and task requests placed by any customer
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Global settings, helpline info and coupons
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
